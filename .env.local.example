# Copy to .env.local and fill in values from your Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Used for magic-link redirects and cookie-domain decisions.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the cron route handler that revalidates room-mappings.
CRON_SECRET=
